    <!-- Pillars on either side -->
    <path android:fillColor="#FFB0A48C" android:pathData="M20,0 L50,0 L50,300 L20,300 Z" />
    <path android:fillColor="#FFB0A48C" android:pathData="M250,0 L280,0 L280,300 L250,300 Z" />
    <path android:fillColor="#FF8C7F66" android:fillAlpha="0.5" android:pathData="M20,0 L28,0 L28,300 L20,300 Z" />
    <path android:fillColor="#FF8C7F66" android:fillAlpha="0.5" android:pathData="M250,0 L258,0 L258,300 L250,300 Z" />
</vector>
