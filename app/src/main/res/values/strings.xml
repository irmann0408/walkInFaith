    <string name="noahs_ark_intro_line_1">Noah trusted God and followed His instructions.</string>
    <string name="noahs_ark_intro_line_2">Will you help Noah get everyone safely aboard the ark?</string>

    <string name="noahs_ark_find_animals_context_title">Two By Two</string>
    <string name="noahs_ark_find_animals_context_line_1">The rain is coming, and Noah needs every animal safely aboard the ark.</string>
    <string name="noahs_ark_find_animals_context_line_2">Look around and find each animal — leave anything that isn\'t an animal behind.</string>

    <string name="noahs_ark_find_animals_title">Find the Animals</string>
    <string name="noahs_ark_find_animals_instructions">Tap each animal to bring it to the ark.</string>

    <string name="noahs_ark_matching_title">Match the Animal Pairs</string>
    <string name="noahs_ark_matching_instructions">Tap two animals that match.</string>

    <string name="noahs_ark_gather_supplies_context_title">Ready for the Journey</string>
    <string name="noahs_ark_gather_supplies_context_line_1">Noah\'s family will need food and water for many days at sea.</string>
    <string name="noahs_ark_gather_supplies_context_line_2">Gather only what the ark truly needs for the trip.</string>

    <string name="noahs_ark_gather_supplies_title">Gather Supplies</string>
    <string name="noahs_ark_gather_supplies_instructions">Tap each supply to pack it for the journey.</string>

    <string name="noahs_ark_organize_context_title">A Place for Everything</string>
    <string name="noahs_ark_organize_context_line_1">Everything on the ark has its own place — animals, food, and supplies.</string>
    <string name="noahs_ark_organize_context_line_2">Put each item where it belongs, and leave behind anything that isn\'t needed.</string>

    <string name="noahs_ark_organize_title">Organize the Ark</string>
    <string name="noahs_ark_organize_instructions">Drag each item into the right area.</string>

    <string name="noahs_ark_missing_items_title">Find the Missing Items</string>
    <string name="noahs_ark_missing_items_instructions">Everything Noah packed is hiding somewhere in here — look closely and tap to find it all!</string>

