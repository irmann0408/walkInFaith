    <string name="noahs_ark_intro_line_1">Noah trusted God and followed His instructions.</string>
    <string name="noahs_ark_intro_line_2">Will you help Noah get everyone safely aboard the ark?</string>

    <string name="noahs_ark_find_animals_context_title">Two By Two</string>
    <string name="noahs_ark_find_animals_context_line_1">The rain is coming, and Noah needs every animal safely aboard the ark.</string>
    <string name="noahs_ark_find_animals_context_line_2">Look around and find each animal — leave anything that isn\'t an animal behind.</string>

    <string name="noahs_ark_find_animals_title">Find the Animals</string>
    <string name="noahs_ark_find_animals_instructions">Tap each animal to bring it to the ark.</string>

    <string name="noahs_ark_matching_title">Match the Animal Pairs</string>
    <string name="noahs_ark_matching_instructions">Tap two animals that match.</string>

    <string name="noahs_ark_gather_supplies_context_title">Ready for the Journey</string>
    <string name="noahs_ark_gather_supplies_context_line_1">Noah\'s family will need food and water for many days at sea.</string>
    <string name="noahs_ark_gather_supplies_context_line_2">Gather only what the ark truly needs for the trip.</string>

    <string name="noahs_ark_gather_supplies_title">Gather Supplies</string>
    <string name="noahs_ark_gather_supplies_instructions">Tap each supply to pack it for the journey.</string>

    <string name="noahs_ark_organize_context_title">A Place for Everything</string>
    <string name="noahs_ark_organize_context_line_1">Everything on the ark has its own place — animals, food, and supplies.</string>
    <string name="noahs_ark_organize_context_line_2">Put each item where it belongs, and leave behind anything that isn\'t needed.</string>

    <string name="noahs_ark_organize_title">Organize the Ark</string>
    <string name="noahs_ark_organize_instructions">Drag each item into the right area.</string>

    <string name="noahs_ark_missing_items_title">Find the Missing Items</string>
    <string name="noahs_ark_missing_items_instructions">Everything Noah packed is hiding somewhere in here — look closely and tap to find it all!</string>

    <string name="noahs_ark_lesson_title">What did we learn?</string>
    <string name="noahs_ark_lesson_text">God wants us to trust Him and follow what is right.</string>

    <string name="david_goliath_intro_line_1">David was just a shepherd boy, but he trusted God with all his heart.</string>
    <string name="david_goliath_intro_line_2">One day a giant named Goliath challenged Israel\'s whole army — and David stepped forward.</string>

    <string name="david_goliath_sheep_counting_context_title">Counting the Flock</string>
    <string name="david_goliath_sheep_counting_context_line_1">Before he could leave, David counted his sheep to make sure they were all safe.</string>
    <string name="david_goliath_sheep_counting_context_line_2">Help him match each number to the right group of sheep.</string>

    <string name="david_goliath_sheep_counting_title">Count the Sheep</string>
    <string name="david_goliath_sheep_counting_instructions">Flip the cards to match each number with its group of sheep.</string>
    <string name="david_goliath_sheep_count_1">1 Sheep</string>
    <string name="david_goliath_sheep_count_2">2 Sheep</string>
    <string name="david_goliath_sheep_count_3">3 Sheep</string>
    <string name="david_goliath_sheep_count_4">4 Sheep</string>
    <string name="david_goliath_sheep_count_5">5 Sheep</string>

    <string name="david_goliath_dodge_context_title">Crossing the Valley</string>
    <string name="david_goliath_dodge_context_line_1">David hurried across the Valley of Elah toward Goliath.</string>
    <string name="david_goliath_dodge_context_line_2">Loose rocks tumbled down the hillside — help him step out of the way.</string>

    <string name="david_goliath_dodge_title">Cross the Valley</string>
    <string name="david_goliath_dodge_instructions">A rock is rolling in! Tap the safe side for David to step to.</string>
    <string name="david_goliath_dodge_lane_left">Step Left</string>
    <string name="david_goliath_dodge_lane_right">Step Right</string>
    <string name="david_goliath_dodge_rock_content_description">Rolling rock</string>

    <string name="david_goliath_choose_stones_context_title">Down by the Stream</string>
    <string name="david_goliath_choose_stones_context_line_1">Before facing Goliath, David went down to a stream near the battlefield.</string>
    <string name="david_goliath_choose_stones_context_line_2">Help him find five smooth stones hidden among the rocks.</string>

    <string name="david_goliath_choose_stones_title">Choose the Stones</string>
    <string name="david_goliath_choose_stones_instructions">Look closely and tap to find five smooth stones for David\'s sling.</string>

    <string name="david_goliath_sling_practice_context_title">Goliath\'s Challenge</string>
    <string name="david_goliath_sling_practice_context_line_1">Goliath towered over the battlefield, mocking David and his God.</string>
    <string name="david_goliath_sling_practice_context_line_2">David answered with courage, not fear.</string>

    <string name="david_goliath_choice_title">What Will David Say?</string>
    <string name="david_goliath_choice_instructions">Choose a brave response for David.</string>
    <string name="david_goliath_choice_option_1">"The Lord will save me — He is with me!"</string>
    <string name="david_goliath_choice_option_2">"I\'m not afraid, because God is bigger than you!"</string>
    <string name="david_goliath_choice_option_3">"You come with a sword, but I come in the name of the Lord!"</string>
    <string name="david_goliath_choice_reaction_1">David spoke with quiet, steady faith!</string>
    <string name="david_goliath_choice_reaction_2">David\'s courage rang out across the valley!</string>
    <string name="david_goliath_choice_reaction_3">David stood tall, trusting God completely!</string>

    <string name="david_goliath_sling_practice_title">Sling Practice</string>
    <string name="david_goliath_sling_practice_instructions">Drag back and let go to help David aim true at the mark.</string>
    <string name="david_goliath_sling_target_mark_content_description">Target mark</string>
    <string name="david_goliath_sling_stone_content_description">David\'s stone. Drag to aim, then let go.</string>

    <string name="david_goliath_lesson_title">Courage and Trusting God</string>
    <string name="david_goliath_lesson_text">David wasn\'t the biggest or the strongest, but he trusted God more than he feared Goliath. When we feel scared, we can remember God is with us too.</string>

